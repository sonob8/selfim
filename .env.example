# selfim 環境変数テンプレート(実値は .env に置き、コミットしないこと)
# プロバイダ: mock (既定, キー不要) | bedrock
SELFIM_MODEL_PROVIDER=mock

# 実行系: local (既定, in-process高速) | docker (AgentCore互換コンテナ実行)
# CLI の --executor が最優先。settings.yaml の executor よりも優先される。
SELFIM_EXECUTOR=local

# Bedrock を使う場合のみ設定
BEDROCK_REGION=us-west-2
BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-6-20251014-v1:0
